# Runtime de la aplicación.
RAGE_NODE_IMAGE=node:24-bookworm

# Repositorio: acepta una rama, etiqueta o SHA completo.
RAGE_REPOSITORY_URL=https://github.com/niflaot/rage-motors.git
RAGE_GIT_REF=main

# PostgreSQL. Usa una contraseña segura que no contenga caracteres que deban
# codificarse en una URL.
RAGE_POSTGRES_IMAGE=postgres:17.6-alpine
RAGE_POSTGRES_DATABASE=ragem
RAGE_POSTGRES_USER=ragem
RAGE_POSTGRES_PASSWORD=REEMPLAZAR_CON_CLAVE_SEGURA

# Better Auth y Discord. La URL debe ser pública, HTTPS y sin barra final.
BETTER_AUTH_SECRET=REEMPLAZAR_CON_SECRETO_DE_AL_MENOS_32_CARACTERES
BETTER_AUTH_URL=https://ragemotors.niflaot.dev
DISCORD_CLIENT_ID=1527502484539707423
DISCORD_CLIENT_SECRET=REEMPLAZAR
AUTHORIZED_DISCORD_IDS=REEMPLAZAR_CON_IDS_REALES_SEPARADOS_POR_COMAS
